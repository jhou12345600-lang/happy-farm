rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /farms/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // 別人的家：只能動田地、牧場、魚塭、加工廠（偷、幫忙、餵食、加速、惡作劇）、留言紀錄、好友名單、裝飾（按讚）、小鎮（市集購買、捐獻蓋廟）
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plots', 'log', 'friends', 'ranch', 'fish', 'fac', 'deco', 'town']);
    }
    match /requests/{id} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 好友送禮
    match /gifts/{id} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 999;
    }
    // 好友合作大訂單：只有成員看得到、能交貨；發起人才能刪除
    match /coops/{id} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
        && request.resource.data.members is list && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() <= 8;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.members == resource.data.members
        && request.resource.data.need == resource.data.need;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
