rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 帳號名稱 → 使用者 ID（註冊時檢查有沒有重複、加好友時搜尋）
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // 每個人的農場
    match /farms/{uid} {
      allow read: if request.auth != null;
      // 自己的農場：全部都能改
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // 別人的農場：只能動田地（偷菜、幫忙、惡作劇）、留言紀錄、好友名單
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plots', 'log', 'friends']);
    }

    // 好友邀請
    match /requests/{id} {
      allow read, delete: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
  }
}
