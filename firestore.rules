rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }
    match /farms/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      // 別人的家：只能動田地、牧場、魚塭（偷、幫忙、餵食、惡作劇）、留言紀錄、好友名單
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plots', 'log', 'friends', 'ranch', 'fish']);
    }
    match /requests/{id} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 好友送禮
    match /gifts/{id} {
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && request.resource.data.n is int && request.resource.data.n > 0 && request.resource.data.n <= 999;
    }
  }
}
